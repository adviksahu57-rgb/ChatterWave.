rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chatUploads/{chatId}/{userId}/{fileName} {
      function isMember() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/chats/$(chatId))
          && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
      }
      allow read: if isMember();
      allow write: if isMember()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
